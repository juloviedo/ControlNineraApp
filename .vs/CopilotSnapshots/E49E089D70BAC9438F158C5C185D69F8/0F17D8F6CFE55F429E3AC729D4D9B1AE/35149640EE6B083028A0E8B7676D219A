
using HorasNiñeras1._0.Models;
using SQLite;

namespace ControlNineras.Services;

public class DatabaseService
{
    private SQLiteAsyncConnection _db;

    private async Task Init()
    {
        if (_db != null)
            return;

        // Ruta local dentro del almacenamiento seguro del celular
        var dbPath = Path.Combine(FileSystem.AppDataDirectory, "ControlNinerasDB.db3");
        _db = new SQLiteAsyncConnection(dbPath);

        // Crear las tablas si no existen
        await _db.CreateTableAsync<Ninera>();
        await _db.CreateTableAsync<RegistroHorario>();
        await _db.CreateTableAsync<CierreMes>();
    }

    // --- MÉTODOS PARA NIÑERAS ---
    public async Task<List<Ninera>> ObtenerNinerasAsync()
    {
        await Init();
        return await _db.Table<Ninera>().Where(n => n.Activa).ToListAsync();
    }

    public async Task<int> GuardarNineraAsync(Ninera ninera)
    {
        await Init();
        if (ninera.Id != 0)
            return await _db.UpdateAsync(ninera);
        else
            return await _db.InsertAsync(ninera);
    }

    // --- MÉTODOS PARA REGISTRO DE HORARIOS Y NOTAS ---
    public async Task<int> GuardarRegistroAsync(RegistroHorario registro)
    {
        await Init();
        if (registro.Id != 0)
            return await _db.UpdateAsync(registro);
        else
            return await _db.InsertAsync(registro);
    }

    public async Task<List<RegistroHorario>> ObtenerRegistrosPorNineraYFechaAsync(int nineraId, DateTime desde, DateTime hasta)
    {
        await Init();
        return await _db.Table<RegistroHorario>()
                         .Where(r => r.NineraId == nineraId && r.Fecha >= desde && r.Fecha <= hasta)
                         .OrderByDescending(r => r.Fecha)
                         .ToListAsync();
    }

    // --- MÉTODOS PARA CIERRE DE MES Y PAGOS ---
    public async Task<int> GuardarCierreMesAsync(CierreMes cierre)
    {
        await Init();
        return await _db.InsertAsync(cierre);
    }

    public async Task<List<CierreMes>> ObtenerHistorialCierresAsync(int nineraId)
    {
        await Init();
        return await _db.Table<CierreMes>()
                         .Where(c => c.NineraId == nineraId)
                         .OrderByDescending(c => c.Anio)
                         .ThenByDescending(c => c.Mes)
                         .ToListAsync();
    }

    //METODO PARA ELIMINAR REGISTROS
    public async Task<int> EliminarRegistroAsync(RegistroHorario registro)
    {
        await Init();
        return await _db.DeleteAsync(registro);
    }
    public async Task<Pago> ObtenerPagoPorMesAnioAsync(int nineraId, int mes, int anio)
    {
        await Init();
        return await _db.Table<Pago>()
                        .Where(p => p.NineraId == nineraId && p.Mes == mes && p.Anio == anio)
                        .FirstOrDefaultAsync();
    }

    public async Task<int> GuardarPagoAsync(Pago pago)
    {
        await Init();
        if (pago.Id != 0)
            return await _db.UpdateAsync(pago);
        else
            return await _db.InsertAsync(pago);
    }

    public async Task<List<Pago>> ObtenerPagosPorNineraAsync(int nineraId)
    {
        await Init();
        return await _db.Table<Pago>()
                        .Where(p => p.NineraId == nineraId)
                        .OrderByDescending(p => p.Anio)
                        .ThenByDescending(p => p.Mes)
                        .ToListAsync();
    }
}   
